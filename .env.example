# Server settings (see README, "Configuration"). The server reads this file itself when it is named .env and sits in the
# repository root; real environment variables win over it.
NODE_ENV=production
PORT=8000
# address to listen on, when the host gives one (Elkdata: the value of ELKDATA_APP_IP); leave out to listen on all
#HOST=
# behind a reverse proxy (Apache, nginx, Caddy) that sends X-Forwarded-For:
TRUST_PROXY=1
# creates the first admin when there are no accounts yet; remove them afterwards:
#ADMIN_USER=
#ADMIN_PASSWORD=
