# Server settings (see README, "Configuration"). The server reads real environment variables; copy these into your host's
# environment (this file is not loaded automatically).
NODE_ENV=production
PORT=3001
# behind a reverse proxy (nginx, Caddy ...) that sends X-Forwarded-For:
TRUST_PROXY=1
# creates the first admin when there are no accounts yet; remove them afterwards:
#ADMIN_USER=
#ADMIN_PASSWORD=
